/-- `R₉` is symmetric on `range 9`. -/
lemma R₉_symm : SymmOn 9 R₉ := by
  intro i hi j hj
  rcases lt_nine_cases (mem_range.1 hi) with
    rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl <;>
  rcases lt_nine_cases (mem_range.1 hj) with
    rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl <;>
  simp

/-- `b₉ᵀe = 1`. -/
lemma b₉_sum : ∑ i ∈ range 9, b₉ i = 1 := by
  rw [show (9:ℕ) = 8+1 from rfl]
  simp only [Finset.sum_range_succ, Finset.sum_range_zero]
  norm_num

/-- `b₉ᵀc₉ = 1/2`. -/
lemma b₉_c₉ : ∑ i ∈ range 9, b₉ i * c₉ i = 1 / 2 := by
  rw [show (9:ℕ) = 8+1 from rfl]
  simp only [Finset.sum_range_succ, Finset.sum_range_zero]
  norm_num

