/-- `c₉` is the vector of row sums of `A₉`: each row of `A₉` has one nonzero entry. -/
lemma c₉_eq_rowSum : ∀ i ∈ range 9, c₉ i = ∑ j ∈ range 9, A₉ i j := by
  intro i hi
  rcases lt_nine_cases (mem_range.1 hi) with
    rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl <;>
    · rw [show (9:ℕ) = 8+1 from rfl]
      simp only [Finset.sum_range_succ, Finset.sum_range_zero]
      norm_num [A₉, c₉]


