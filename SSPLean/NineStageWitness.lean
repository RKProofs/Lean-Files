/-! ## Verification

`A₉`, `b₉`, `R₉`, `c₉` are defined by `match` on the indices, so every check below reduces
to finitely many rational identities.  For statements quantified over `range 9` we split the
index with `Finset.mem_range` and `omega`, then evaluate with `norm_num`. -/

/-- Split a natural number below `9` into its nine cases. -/
lemma lt_nine_cases {i : ℕ} (hi : i < 9) :
    i = 0 ∨ i = 1 ∨ i = 2 ∨ i = 3 ∨ i = 4 ∨ i = 5 ∨ i = 6 ∨ i = 7 ∨ i = 8 := by
  omega

/-- `A₉` is entrywise nonnegative. -/
lemma A₉_nonneg : ∀ i j, 0 ≤ A₉ i j := by
  intro i j
  change (0:ℝ) ≤ (match i, j with
    | 0, 3 => 13/43200 | 1, 4 => 8/41 | 2, 0 => 1/5 | 3, 5 => 9/20
    | 4, 6 => 11/24 | 5, 1 => 41/78 | 6, 7 => 8/11 | 7, 3 => 13/4800
    | 7, 8 => 3/4 | 8, 2 => 5/6 | _, _ => 0)
  split <;> norm_num

/-- `b₉` is positive on the stage range. -/
lemma b₉_pos : ∀ i ∈ range 9, 0 < b₉ i := by
  intro i hi
  rcases lt_nine_cases (mem_range.1 hi) with
    rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl <;> norm_num [b₉]

