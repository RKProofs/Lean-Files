/-- The abscissas are strictly increasing. -/
lemma c₉_mono : ∀ i ∈ range 9, ∀ j ∈ range 9, i < j → c₉ i < c₉ j := by
  intro i hi j hj hij
  rcases lt_nine_cases (mem_range.1 hi) with
    rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl <;>
  rcases lt_nine_cases (mem_range.1 hj) with
    rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl <;>
  first
    | (exact absurd hij (by omega))
    | norm_num

/-- The abscissas lie in `[0, 1]`. -/
lemma c₉_range : ∀ i ∈ range 9, 0 ≤ c₉ i ∧ c₉ i ≤ 1 := by
  intro i hi
  rcases lt_nine_cases (mem_range.1 hi) with
    rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl <;> norm_num


