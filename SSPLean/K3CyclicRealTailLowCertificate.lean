noncomputable def varianceLowBernsteinCoeffQ (i j k : ℕ) : ℚ :=
  let p := varianceLowBernsteinPair i j k
  (p.1 : ℚ) / ((p.2 + 1 : ℕ) : ℚ)

theorem varianceLowBernsteinCoeffQ_nonneg :
    ∀ i j k, 0 ≤ varianceLowBernsteinCoeffQ i j k := by
  intro i j k
  unfold varianceLowBernsteinCoeffQ
  positivity

noncomputable def varianceLowBernsteinCoeff (i j k : ℕ) : ℝ :=
  varianceLowBernsteinCoeffQ i j k

theorem varianceLowBernsteinCoeff_nonneg :
    ∀ i j k, 0 ≤ varianceLowBernsteinCoeff i j k := by
  intro i j k
  unfold varianceLowBernsteinCoeff
  exact_mod_cast varianceLowBernsteinCoeffQ_nonneg i j k

end SSP.K3CyclicRealTail
