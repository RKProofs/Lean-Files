noncomputable def fullCoeff7 (i j : ℕ) : ℝ := fullCoeff7Q i j

set_option maxHeartbeats 0 in
theorem fullCoeff7_nonneg (i : ℕ) (hi : i ∈ Finset.range 13)
    (j : ℕ) (hj : j ∈ Finset.range 13) : 0 ≤ fullCoeff7 i j := by
  have hi' := Finset.mem_range.mp hi
  have hj' := Finset.mem_range.mp hj
  interval_cases i <;> interval_cases j <;> norm_num [fullCoeff7, fullCoeff7Q]

set_option maxHeartbeats 0 in
theorem fullCurvatureCoefficient_chart_7_certificate (s d : ℝ) :
    fullCurvatureCoefficient (realRootChartU s d) (realRootChartV s d) 7 =
      tensorBernstein2 12 fullCoeff7 (s ^ 2) (d ^ 2) := by
  norm_num (config := { maxSteps := 2000000 })
    [fullCurvatureCoefficient, varianceCoefficient, symmetricProduct,
      normalizedComplete, splitWeight, splitKappa, complete3, diagonal,
      realRootChartU, realRootChartV, tensorBernstein2, fullCoeff7, fullCoeff7Q,
      bernsteinBasis, Finset.sum_range_succ, Nat.choose]
  ring

theorem fullCurvatureCoefficient_chart_7_nonneg
    {s d : ℝ} (hs0 : 0 ≤ s) (hs1 : s ≤ 1)
    (hd0 : 0 ≤ d) (hd1 : d ≤ 1) :
    0 ≤ fullCurvatureCoefficient
      (realRootChartU s d) (realRootChartV s d) 7 := by
  apply fullCurvatureCoefficient_chart_nonneg_of_bernstein
    hs0 hs1 hd0 hd1 fullCoeff7_nonneg
  exact fullCurvatureCoefficient_chart_7_certificate s d

