noncomputable def fullCoeff6 (i j : ℕ) : ℝ := fullCoeff6Q i j

set_option maxHeartbeats 0 in
theorem fullCoeff6_nonneg (i : ℕ) (hi : i ∈ Finset.range 12)
    (j : ℕ) (hj : j ∈ Finset.range 12) : 0 ≤ fullCoeff6 i j := by
  have hi' := Finset.mem_range.mp hi
  have hj' := Finset.mem_range.mp hj
  interval_cases i <;> interval_cases j <;> norm_num [fullCoeff6, fullCoeff6Q]

set_option maxHeartbeats 0 in
theorem fullCurvatureCoefficient_chart_6_certificate (s d : ℝ) :
    fullCurvatureCoefficient (realRootChartU s d) (realRootChartV s d) 6 =
      tensorBernstein2 11 fullCoeff6 (s ^ 2) (d ^ 2) := by
  norm_num (config := { maxSteps := 2000000 })
    [fullCurvatureCoefficient, varianceCoefficient, symmetricProduct,
      normalizedComplete, splitWeight, splitKappa, complete3, diagonal,
      realRootChartU, realRootChartV, tensorBernstein2, fullCoeff6, fullCoeff6Q,
      bernsteinBasis, Finset.sum_range_succ, Nat.choose]
  ring

theorem fullCurvatureCoefficient_chart_6_nonneg
    {s d : ℝ} (hs0 : 0 ≤ s) (hs1 : s ≤ 1)
    (hd0 : 0 ≤ d) (hd1 : d ≤ 1) :
    0 ≤ fullCurvatureCoefficient
      (realRootChartU s d) (realRootChartV s d) 6 := by
  apply fullCurvatureCoefficient_chart_nonneg_of_bernstein
    hs0 hs1 hd0 hd1 fullCoeff6_nonneg
  exact fullCurvatureCoefficient_chart_6_certificate s d

