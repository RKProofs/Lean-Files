noncomputable def fullCoeff8 (i j : ℕ) : ℝ := fullCoeff8Q i j

set_option maxHeartbeats 0 in
theorem fullCoeff8_nonneg (i : ℕ) (hi : i ∈ Finset.range 14)
    (j : ℕ) (hj : j ∈ Finset.range 14) : 0 ≤ fullCoeff8 i j := by
  have hi' := Finset.mem_range.mp hi
  have hj' := Finset.mem_range.mp hj
  interval_cases i <;> interval_cases j <;> norm_num [fullCoeff8, fullCoeff8Q]

set_option maxHeartbeats 0 in
theorem fullCurvatureCoefficient_chart_8_certificate (s d : ℝ) :
    fullCurvatureCoefficient (realRootChartU s d) (realRootChartV s d) 8 =
      tensorBernstein2 13 fullCoeff8 (s ^ 2) (d ^ 2) := by
  norm_num (config := { maxSteps := 2000000 })
    [fullCurvatureCoefficient, varianceCoefficient, symmetricProduct,
      normalizedComplete, splitWeight, splitKappa, complete3, diagonal,
      realRootChartU, realRootChartV, tensorBernstein2, fullCoeff8, fullCoeff8Q,
      bernsteinBasis, Finset.sum_range_succ, Nat.choose]
  ring

theorem fullCurvatureCoefficient_chart_8_nonneg
    {s d : ℝ} (hs0 : 0 ≤ s) (hs1 : s ≤ 1)
    (hd0 : 0 ≤ d) (hd1 : d ≤ 1) :
    0 ≤ fullCurvatureCoefficient
      (realRootChartU s d) (realRootChartV s d) 8 := by
  apply fullCurvatureCoefficient_chart_nonneg_of_bernstein
    hs0 hs1 hd0 hd1 fullCoeff8_nonneg
  exact fullCurvatureCoefficient_chart_8_certificate s d

